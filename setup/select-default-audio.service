[Unit]
Description=Select default ALSA output (USB sound card if present, else HDMI speakers)
# Run after the kernel has had a chance to enumerate USB/sound, and before
# EmulationStation (which autostarts from the tty1 autologin on RetroPie), so
# the default is set before anything opens audio.
After=local-fs.target
Before=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/select-default-audio.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
