[Unit]
Description=WS2812 LED Control Service (LEDControl.py)
# No network dependency — this drives local SPI and a localhost-only WebSocket.
# Do NOT order it after network.target/multi-user.target: a slow unit in that
# chain (e.g. Samba's nmbd timing out ~90s when WiFi is down at boot) would
# otherwise keep the LED strip dark until it clears. Start early, in parallel.
After=basic.target

[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/LEDControl
ExecStart=/home/pi/LEDControl/venv/bin/python3 /home/pi/LEDControl/LEDControl.py 
Restart=on-failure
RestartSec=5
TimeoutStopSec=5
StandardOutput=journal
StandardError=journal
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
