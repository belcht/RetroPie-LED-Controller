[Unit]
Description=Clear WS2812 LEDs on shutdown/reboot
DefaultDependencies=no
Before=umount.target shutdown.target reboot.target halt.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/leds-off-on-shutdown.sh
RemainAfterExit=yes
TimeoutSec=10

[Install]
WantedBy=halt.target reboot.target shutdown.target
